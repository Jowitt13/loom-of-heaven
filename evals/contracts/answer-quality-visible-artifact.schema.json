{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom:eval/answer-quality-visible-artifact/v1",
  "title": "IQ-0 Sanitized Visible Answer Artifact",
  "description": "Carrier for the final, sanitized, user-visible answer text of one evaluation case. It stores only the delivered prose plus provenance digests and sanitization attestations. It is NOT a raw provider/model response, NOT a ReadingDraft internal object, NOT a session transcript, and carries no prompt, hidden reasoning, token log, provider metadata or personal data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "artifactId",
    "caseId",
    "topic",
    "role",
    "visibleText",
    "producerClass",
    "pipelineRevision",
    "rulesetRefs",
    "sourceArtifactDigests",
    "sanitization",
    "exclusionPolicy"
  ],
  "properties": {
    "contractVersion": { "const": "answer-quality-visible-artifact/v1" },
    "artifactId": {
      "type": "string",
      "pattern": "^artifact:synthetic:[a-z0-9][a-z0-9._-]*$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^case:synthetic:career:[a-z0-9][a-z0-9._-]*$"
    },
    "topic": { "const": "career" },
    "role": {
      "enum": ["legacy-baseline", "candidate", "accepted-reference", "regression"]
    },
    "visibleText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "producerClass": {
      "enum": ["current-pipeline", "human-authored-synthetic", "host-assisted-sanitized"]
    },
    "pipelineRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "rulesetRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourceArtifactDigests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "syntheticInputOnly",
        "rawTranscriptExcluded",
        "rawPromptExcluded",
        "modelReasoningExcluded",
        "personalDataExcluded"
      ],
      "properties": {
        "syntheticInputOnly": { "const": true },
        "rawTranscriptExcluded": { "const": true },
        "rawPromptExcluded": { "const": true },
        "modelReasoningExcluded": { "const": true },
        "personalDataExcluded": { "const": true }
      }
    },
    "exclusionPolicy": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    }
  }
}
