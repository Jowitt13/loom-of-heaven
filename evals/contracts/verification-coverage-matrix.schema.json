{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom:eval/verification-coverage-matrix/v1",
  "title": "Synthetic Verification Coverage Matrix",
  "description": "Development-only coverage/gap traceability for the existing eval verifiers. It binds each fixed risk layer to real verifier exports, positive test titles, and negative or mutation bindings. It declares no accuracy metric of any kind and no free-text gap prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "suiteId",
    "fixtureId",
    "mode",
    "mutationCatalogDigest",
    "rows",
    "exclusionPolicy"
  ],
  "properties": {
    "contractVersion": { "const": "verification-coverage-matrix/v1" },
    "suiteId": {
      "type": "string",
      "pattern": "^coverage-suite:synthetic:[a-z0-9][a-z0-9._-]*$"
    },
    "fixtureId": { "type": "string", "pattern": "^synthetic:[a-z0-9][a-z0-9._-]*$" },
    "mode": { "const": "deterministic-local-only" },
    "mutationCatalogDigest": { "$ref": "#/$defs/sha256" },
    "rows": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "riskId",
          "layer",
          "coverageStatus",
          "verifierBindings",
          "positiveTestBindings",
          "negativeBindings",
          "gapIds"
        ],
        "properties": {
          "riskId": {
            "type": "string",
            "pattern": "^risk:synthetic:[a-z0-9][a-z0-9._-]*$"
          },
          "layer": {
            "enum": [
              "contract-shape",
              "privacy-field-exclusion",
              "baseline-integrity-linkage",
              "dependency-collector-linkage",
              "invalidation-truth-table",
              "conclusion-vector-linkage",
              "lifecycle-reuse-decision",
              "mutation-detection-evidence"
            ]
          },
          "coverageStatus": {
            "enum": ["covered", "partially-covered", "blocked", "out-of-scope"]
          },
          "verifierBindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "exportName"],
              "properties": {
                "file": { "type": "string" },
                "exportName": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$" }
              }
            }
          },
          "positiveTestBindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "testTitle"],
              "properties": {
                "file": { "type": "string" },
                "testTitle": { "type": "string" }
              }
            }
          },
          "negativeBindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "caseId"],
                  "properties": {
                    "kind": { "const": "mutation-case" },
                    "caseId": {
                      "type": "string",
                      "pattern": "^mutation:synthetic:[a-z0-9][a-z0-9._-]*$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "file", "testTitle"],
                  "properties": {
                    "kind": { "const": "negative-test" },
                    "file": { "type": "string" },
                    "testTitle": { "type": "string" }
                  }
                }
              ]
            }
          },
          "gapIds": {
            "type": "array",
            "items": {
              "enum": [
                "p0d-contract-no-dedicated-mutation",
                "collector-algorithm-mutation-not-covered"
              ]
            }
          }
        }
      }
    },
    "exclusionPolicy": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
