{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom:eval/shadow-state-lifecycle-matrix/v1",
  "title": "Synthetic Shadow State Lifecycle Matrix",
  "description": "Development-only P1-A/P1-B/P1-C lifecycle evidence. It contains no state values, input data, prose, or model material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "fixtureId",
    "mode",
    "stateContractVersion",
    "stateDigest",
    "cases",
    "exclusionPolicy"
  ],
  "properties": {
    "contractVersion": { "const": "shadow-state-lifecycle-matrix/v1" },
    "fixtureId": { "type": "string", "pattern": "^synthetic:[a-z0-9][a-z0-9._-]*$" },
    "mode": { "const": "deterministic-local-only" },
    "stateContractVersion": { "const": "bazi-shadow-state/p0b" },
    "stateDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "cases": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "causes", "rightStateVariant", "expected"],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^lifecycle:synthetic:[a-z0-9][a-z0-9._-]*$"
          },
          "causes": {
            "type": "array",
            "maxItems": 7,
            "items": {
              "enum": [
                "input-chart",
                "settings",
                "engine-provider",
                "ruleset",
                "source-profile",
                "topic-lens",
                "language-narrator"
              ]
            }
          },
          "rightStateVariant": {
            "enum": ["identical", "month-primary-cleared", "engine-version-changed"]
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stateRecordReusable",
              "projectionRefreshRequired",
              "recomputeReasons",
              "invalidatedNodeIds",
              "changedResolutionPaths",
              "changedNodeIds"
            ],
            "properties": {
              "stateRecordReusable": { "type": "boolean" },
              "projectionRefreshRequired": { "type": "boolean" },
              "recomputeReasons": {
                "type": "array",
                "items": { "enum": ["invalidation-plan", "observed-diff"] }
              },
              "invalidatedNodeIds": {
                "type": "array",
                "items": {
                  "enum": [
                    "bazi.shadow.direct-roots",
                    "bazi.shadow.relation-geometry",
                    "bazi.shadow.strength-inputs",
                    "bazi.shadow.pattern-inputs"
                  ]
                }
              },
              "changedResolutionPaths": {
                "type": "array",
                "items": { "type": "string", "pattern": "^resolution\\.[a-zA-Z0-9_.\\[\\]-]+$" }
              },
              "changedNodeIds": {
                "type": "array",
                "items": {
                  "enum": [
                    "bazi.shadow.direct-roots",
                    "bazi.shadow.relation-geometry",
                    "bazi.shadow.strength-inputs",
                    "bazi.shadow.pattern-inputs"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "exclusionPolicy": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    }
  }
}
