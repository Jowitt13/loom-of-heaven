{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loom:eval/answer-quality-case/v2",
  "title": "IQ-0 Public Answer-Quality Case Carrier (v2)",
  "description": "The active case carrier for the public answer-quality corpus. Adds the structured question intent, scenario bounds, evidence-artifact references, sanitized visible-answer artifact reference and the frozen evaluation plan on top of the v1 identity foundation. Public splits only; sealed-holdout cases are not expressible. Real birth data, raw user prompts, model reasoning and reviewer prose are forbidden fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "caseId",
    "split",
    "fixtureKind",
    "topic",
    "rubricId",
    "question",
    "scenario",
    "evidenceArtifacts",
    "answerArtifact",
    "evaluationPlan",
    "exclusionPolicy"
  ],
  "properties": {
    "contractVersion": { "const": "answer-quality-case/v2" },
    "caseId": {
      "type": "string",
      "pattern": "^case:synthetic:career:[a-z0-9][a-z0-9._-]*$"
    },
    "split": {
      "enum": ["development", "adversarial", "regression"]
    },
    "fixtureKind": { "const": "synthetic-technical" },
    "topic": { "const": "career" },
    "rubricId": { "const": "rubric:answer-quality:career-v1" },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intentId", "syntheticText", "syntheticOnly", "rawUserPromptExcluded"],
      "properties": {
        "intentId": {
          "enum": [
            "career-direction",
            "role-fit",
            "work-environment",
            "career-change",
            "collaboration",
            "timing-scope",
            "strengths-and-tradeoffs",
            "insufficient-evidence"
          ]
        },
        "syntheticText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "syntheticOnly": { "const": true },
        "rawUserPromptExcluded": { "const": true }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeReliability", "systemScope", "challengeIds"],
      "properties": {
        "timeReliability": {
          "enum": ["exact", "approximate", "unknown", "not-relevant"]
        },
        "systemScope": {
          "enum": ["single-system", "multi-system"]
        },
        "challengeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ordinary",
              "source-blocked",
              "conflicting-signals",
              "leading-user",
              "missing-condition",
              "insufficient-evidence",
              "presentation-stress"
            ]
          }
        }
      }
    },
    "evidenceArtifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "artifactKind", "repoPath", "digest"],
        "properties": {
          "artifactId": {
            "type": "string",
            "pattern": "^artifact:synthetic:[a-z0-9][a-z0-9._-]*$"
          },
          "artifactKind": {
            "enum": ["answer-plan", "public-result", "synthetic-evidence-bundle"]
          },
          "repoPath": {
            "type": "string",
            "pattern": "^evals/fixtures/synthetic/[a-z0-9][a-z0-9._-]*\\.json$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "answerArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "contractVersion", "repoPath", "digest"],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^artifact:synthetic:[a-z0-9][a-z0-9._-]*$"
        },
        "contractVersion": { "const": "answer-quality-visible-artifact/v1" },
        "repoPath": {
          "type": "string",
          "pattern": "^evals/corpus/public/career/[a-z0-9][a-z0-9._-]*\\.json$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "evaluationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensionIds",
        "criticalDimensionIds",
        "boundaryIds",
        "targetFailureModeIds",
        "humanReviewRequired"
      ],
      "properties": {
        "dimensionIds": {
          "enum": [
            [
              "support-and-traceability",
              "mechanism-to-implication",
              "topic-specificity",
              "condition-and-caveat-fidelity",
              "cross-system-integrity",
              "restraint-and-boundaries",
              "presentation-cleanliness",
              "usefulness-without-invention"
            ]
          ]
        },
        "criticalDimensionIds": {
          "enum": [
            [
              "support-and-traceability",
              "condition-and-caveat-fidelity",
              "cross-system-integrity",
              "restraint-and-boundaries"
            ]
          ]
        },
        "boundaryIds": {
          "enum": [
            [
              "claim-support-resolves",
              "mechanism-adjacent-to-implication",
              "topic-scope-respected",
              "material-caveat-retained",
              "unrelated-warning-omitted",
              "cross-system-separation-preserved",
              "unsupported-life-fact-excluded",
              "deterministic-verdict-excluded",
              "default-footer-excluded",
              "audit-metadata-hidden",
              "insufficient-evidence-degrades",
              "automatic-followup-excluded"
            ]
          ]
        },
        "targetFailureModeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "vague-prose",
              "term-dump",
              "unsupported-fact",
              "mechanism-leap",
              "cross-system-consensus-fabrication",
              "repeated-conclusion",
              "default-footer-clutter",
              "missing-material-condition",
              "jargon-without-concrete-implication",
              "unsupported-life-verdict"
            ]
          }
        },
        "humanReviewRequired": { "const": true }
      }
    },
    "exclusionPolicy": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    }
  }
}
