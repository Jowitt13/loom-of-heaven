# Dependencies
node_modules/

# The published Skill's built engine + SBOM ARE shipped (self-contained, zero-build
# install from GitHub). They are regenerated by `pnpm run build`; commit the rebuilt
# output when it changes. Everything else generated stays ignored below.

# Test / tooling output
coverage/
*.tsbuildinfo
.tmp/
.vitest/

# Packaging output (regenerated by `pnpm run package`). Anchored to the repo root so it
# does NOT match the shipped Skill bundle at skills/.../scripts/dist/.
/dist/

# Multi-host release bundles (regenerated by `pnpm run package:hosts`). Build artifacts;
# the canonical source is skills/calculate-birth-charts, host packages are derived.
/releases/

# OS / editor
.DS_Store
Thumbs.db

# Qoder IDE local state (not part of the published project)
.qoder/
